<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NetDebugBar</RootNamespace>
    <PackageId>NetDebugBar</PackageId>
    <Version>1.0.0</Version>
    <Description>A development debug bar for ASP.NET Core 9 applications</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Rendering\Templates\*.css" />
    <EmbeddedResource Include="Rendering\Templates\*.js" />
  </ItemGroup>

</Project>
